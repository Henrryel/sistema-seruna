# Copie este archivo a .env.local y complete los valores.

# Conexión a la base existente (esquema excelencia_seruna). La app fija search_path y timezone por conexión.
# Si omite la contraseña, node-postgres usa PGPASSWORD o el archivo PGPASSFILE.
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/seruna_db
# Tamaño del pool de conexiones
DATABASE_POOL_MAX=10
# true si el servidor exige SSL
DATABASE_SSL=false

# Base para pruebas de integración (restaurada desde db/seruna_back.dump). Las pruebas hacen ROLLBACK.
DATABASE_URL_TEST=postgres://usuario:contraseña@localhost:5432/seruna_test

# URL pública de la app (se usa para validar Origin/CSRF y en enlaces de activación)
APP_URL=http://localhost:3000

# Duración de la sesión en horas
SESION_HORAS=12

# Carpeta donde se guardan los archivos (tabla archivos.clave_almacenamiento es relativa a esta carpeta)
STORAGE_DIR=./storage

# Procesar la cola de documentos (documentos_emitidos) dentro del servidor Next: 1 = sí
WORKER_REPORTES=1
# Usuario técnico (usuarios.id) que figura como procesado_por al emitir documentos de la cola
WORKER_USUARIO_ID=
# Cada cuántos milisegundos revisa la cola el worker
WORKER_REPORTES_INTERVALO_MS=15000

# Nombre institucional que aparece en PDFs y carnets
INSTITUCION_NOMBRE=I.E.P. Excelencia Seruna
INSTITUCION_RUC=
INSTITUCION_DIRECCION=
