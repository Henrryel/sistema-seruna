{
  "name": "seruna",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Gestión Escolar SERUNA sobre la base existente excelencia_seruna",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:tipos": "kysely-codegen --dialect postgres --default-schema excelencia_seruna --include-pattern \"excelencia_seruna.*\" --date-parser string --numeric-parser string --out-file src/server/db/tipos.ts",
    "db:errores": "node scripts/db/generar-errores.mjs docs/db/catalogo.json src/server/errores/mensajes-db.ts",
    "admin:crear": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/crear-admin.ts",
    "demo:sembrar": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/sembrar-demo.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-table": "^8.21.3",
    "@zxing/browser": "^0.2.1",
    "bwip-js": "^4.11.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "kysely": "^0.29.9",
    "lucide-react": "^1.74.0",
    "next": "^15.5.29",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "3.25"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bwip-js": "^3.2.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "kysely-codegen": "^0.20.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
